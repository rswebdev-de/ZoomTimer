# Environment Configuration

## Server
NODE_ENV=production
PORT=3000
# Path prefix if a reverse proxy serves the app from a subdirectory (e.g. /apps/timer)
PUBLIC_URL=

## Dev only (used by docker-compose.override.yml)
# ngrok authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Static domain from https://dashboard.ngrok.com/domains (e.g. your-app.ngrok-free.app)
NGROK_DOMAIN=
