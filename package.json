{
  "name": "zoom-timer-app",
  "version": "1.0.0",
  "description": "A Zoom Marketplace Timer App for managing time in meetings",
  "main": "dist/bundle.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "start": "node server.js",
    "docker:dev": "docker compose --profile dev",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.production.yml",
    "docker:prod:up": "npm run docker:prod -- up --build -d",
    "docker:dev:up": "npm run docker:dev -- up --build -d",
    "docker:prod:down": "npm run docker:prod -- down",
    "docker:dev:down": "npm run docker:dev -- down",
    "test": "jest"
  },
  "keywords": [
    "zoom",
    "timer",
    "marketplace",
    "app"
  ],
  "author": "Zoom",
  "license": "MIT",
  "dependencies": {
    "@zoom/appssdk": "^0.16.0",
    "express": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.3",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.2.0",
    "style-loader": "^4.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  }
}
